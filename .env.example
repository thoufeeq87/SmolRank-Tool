DJANGO_SECRET_KEY=change-me
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=smolrank1.p.rapidapi.com
SMOLRANK_SUBSCRIBER_THRESHOLD=10000
DJANGO_DEBUG=True
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=SmolRank <login@your-verified-domain.com>
SITE_URL=http://localhost:8000
MAGIC_LINK_EXPIRY_MINUTES=15
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=your-polar-sandbox-access-token
POLAR_WEBHOOK_SECRET=whsec_your-polar-webhook-secret
ADMIN_URL=change-me-to-a-long-random-string

# Production only (config.settings.prod). DJANGO_SECRET_KEY must be 50+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_ALLOWED_HOSTS=your-domain.com
# DJANGO_BEHIND_PROXY=True      # set when a proxy/host terminates HTTPS (Railway, Render, nginx)
# DJANGO_HSTS_SECONDS=3600      # raise to 31536000 once HTTPS works everywhere

# Database. Leave DATABASE_URL unset to use the local SQLite file.
# Local dev against Railway: use the Postgres service's *public* URL (DATABASE_PUBLIC_URL):
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
# On a Railway-deployed app set DATABASE_URL to the reference ${{Postgres.DATABASE_URL}} (private network).
# DATABASE_SSL_REQUIRE=True     # force TLS
# TEST_ON_POSTGRES=1            # run `manage.py test` against DATABASE_URL instead of SQLite
